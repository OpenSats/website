{
  "name": "opensats",
  "version": "0.2.0",
  "private": true,
  "scripts": {
    "start": "next dev",
    "dev": "cross-env INIT_CWD=$PWD next dev",
    "build": "contentlayer2 build && node ./scripts/generate-default-og.mjs && node ./scripts/generate-project-og.mjs && node ./scripts/generate-fund-og.mjs && node ./scripts/generate-newsletter-og.mjs && node ./scripts/generate-topic-og.mjs && node -r esbuild-register ./scripts/generate-page-og.mjs && node ./scripts/generate-author-og.mjs && node ./scripts/generate-heartbeat-og.mjs && npm run generate:blog-og && npm run check:og && cross-env INIT_CWD=$PWD next build && node -r esbuild-register ./scripts/postbuild.mjs",
    "serve": "next start",
    "analyze": "cross-env ANALYZE=true next build",
    "generate:default-og": "node ./scripts/generate-default-og.mjs",
    "generate:project-og": "node ./scripts/generate-project-og.mjs",
    "generate:fund-og": "node ./scripts/generate-fund-og.mjs",
    "generate:newsletter-og": "node ./scripts/generate-newsletter-og.mjs",
    "generate:topic-og": "node ./scripts/generate-topic-og.mjs",
    "generate:page-og": "node -r esbuild-register ./scripts/generate-page-og.mjs",
    "generate:author-og": "node ./scripts/generate-author-og.mjs",
    "generate:heartbeat-og": "node ./scripts/generate-heartbeat-og.mjs",
    "lint": "next lint --fix --dir pages --dir components --dir lib --dir layouts --dir scripts",
    "test": "jest",
    "generate:blog-og": "node -r esbuild-register ./scripts/generate-blog-og.mjs",
    "check:og": "node -r esbuild-register ./scripts/check-og-images.mjs"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "dependencies": {
    "@fortawesome/fontawesome-svg-core": "^6.4.0",
    "@fortawesome/free-brands-svg-icons": "^6.4.0",
    "@fortawesome/free-regular-svg-icons": "^6.4.0",
    "@fortawesome/free-solid-svg-icons": "^6.4.0",
    "@fortawesome/react-fontawesome": "^0.2.0",
    "@next/bundle-analyzer": "15.5.29",
    "@octokit/rest": "^22.0.0",
    "@sendgrid/mail": "^7.7.0",
    "@tailwindcss/forms": "^0.5.3",
    "@tailwindcss/typography": "^0.5.9",
    "autoprefixer": "^10.4.13",
    "babel-plugin-macros": "^3.1.0",
    "contentlayer2": "0.5.8",
    "email-validator": "^2.0.4",
    "esbuild": "0.27.3",
    "fathom-client": "^3.7.2",
    "github-slugger": "^1.5.0",
    "gray-matter": "^4.0.2",
    "image-size": "1.0.0",
    "marked": "^15.0.8",
    "mdx-bundler": "^10.1.1",
    "next": "15.5.29",
    "next-contentlayer2": "0.5.8",
    "next-themes": "^0.2.0",
    "pliny": "0.4.1",
    "postcss": "^8.4.16",
    "public-google-sheets-parser": "^1.5.4",
    "react": "18.2.0",
    "react-dom": "18.2.0",
    "react-hook-form": "^7.43.9",
    "react-markdown": "^10.1.0",
    "react-modal": "^3.16.1",
    "react-youtube": "^10.1.0",
    "reading-time": "1.5.0",
    "rehype-autolink-headings": "^7.1.0",
    "rehype-citation": "^2.3.2",
    "rehype-katex": "^7.0.1",
    "rehype-preset-minify": "7.0.1",
    "rehype-prism-plus": "^2.0.2",
    "rehype-slug": "^6.0.0",
    "remark": "^15.0.1",
    "remark-gfm": "^4.0.1",
    "remark-html": "^16.0.1",
    "remark-math": "^6.0.0",
    "stripe": "^12.6.0",
    "tailwindcss": "^3.2.2",
    "typed.js": "^2.0.16",
    "unist-util-visit": "^5.0.0"
  },
  "devDependencies": {
    "@resvg/resvg-js": "^2.6.2",
    "@svgr/webpack": "^6.3.1",
    "@tailwindcss/aspect-ratio": "^0.4.2",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.2.0",
    "@types/jest": "^29.5.14",
    "@types/react": "^18.0.18",
    "@typescript-eslint/eslint-plugin": "^5.36.2",
    "@typescript-eslint/parser": "^5.36.2",
    "cross-env": "^7.0.3",
    "dedent": "^0.7.0",
    "esbuild-register": "3.4.2",
    "eslint": "^8.23.0",
    "eslint-config-next": "15.5.29",
    "eslint-config-prettier": "^8.5.0",
    "eslint-plugin-prettier": "^4.2.1",
    "file-loader": "^6.0.0",
    "globby": "11.0.3",
    "husky": "^8.0.0",
    "jest": "^29.7.0",
    "jest-environment-jsdom": "^29.7.0",
    "js-yaml": "4.1.0",
    "lint-staged": "^13.0.0",
    "prettier": "^2.7.0",
    "prettier-plugin-tailwindcss": "^0.2.2",
    "sharp": "^0.35.5",
    "typescript": "^5.9.3"
  },
  "lint-staged": {
    "*.+(js|jsx|ts|tsx)": [
      "eslint --fix"
    ],
    "*.+(js|jsx|ts|tsx|json|css|md|mdx)": [
      "prettier --write"
    ]
  }
}
